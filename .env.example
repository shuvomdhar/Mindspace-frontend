# ---------------------------------------------------------------------------
# Mindspace frontend environment
# Copy this file to `.env.local` and fill in the values from Supabase.
# ---------------------------------------------------------------------------

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Project Settings → API → anon public key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google OAuth Client ID and Client Secret do NOT belong in this file for a
# hosted Supabase project. Add them in the Supabase Dashboard under
# Authentication → Providers → Google.

# Express API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000
